[Unit]
Description=ModelizmClub frontend socket (держит :3000 поверх перезапусков)
# Сокет живёт отдельно от сервиса и переживает его перезапуск. Пока сервис
# останавливается и поднимается заново, соединения копятся в очереди ядра:
# nginx ждёт ответа вместо ECONNREFUSED. До 05.09 каждое переключение релиза
# давало окно около 0,7 с с ответами 502 — замерено опросом каждые 100 мс.

[Socket]
ListenStream=127.0.0.1:3000
# Один слушающий сокет на весь сервис: соединения принимает приложение, а не
# systemd, — иначе на каждое соединение поднимался бы отдельный процесс.
Accept=no
# Очередь, в которой ждут соединения, пока приложение перезапускается.
Backlog=1024
# Node ждёт неблокирующий дескриптор.
NoDelay=true
Service=modelizmclub-frontend.service

[Install]
WantedBy=sockets.target
