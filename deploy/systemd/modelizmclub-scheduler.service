[Unit]
Description=ModelizmClub Laravel scheduler (one tick)
Documentation=file:///var/www/modelizmclub/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# Не root: артизан пишет storage/logs и bootstrap/cache, и файлы, созданные
# от root, php-fpm потом не перезапишет — очередь и логи встанут молча.
User=www-data
Group=www-data
WorkingDirectory=/var/www/modelizmclub/backend
ExecStart=/usr/bin/php /var/www/modelizmclub/backend/artisan schedule:run
# Тик планировщика — это диспетчер: он запускает задачи и выходит. Минуты
# хватает с запасом; всё, что дольше десяти, застряло на внешнем API.
TimeoutStartSec=600
Nice=10
# Задачи, помеченные runInBackground, должны пережить выход диспетчера.
#
# `Type=oneshot` с умолчанием `KillMode=control-group` считает юнит
# завершённым, как только `schedule:run` вышел, и сносит всю контрольную
# группу — вместе с фоновыми задачами, которые он только что запустил.
# Laravel запускает их так:
#
#   ( artisan <команда> ; artisan schedule:finish <ключ замка> ) &
#
# Убитая на первой секунде задача до `schedule:finish` не доходит, и замок
# `withoutOverlapping` остаётся висеть до истечения срока.
#
# Замерено на проде 08.09: в 18:40:01 журнал пишет «Running […] in background
# 2.27ms DONE», через двадцать секунд процесса команды уже нет, а замок
# держится. Команда, которой нужны десятки секунд на опрос банка, не
# отрабатывала ни разу с момента, как её пометили фоновой.
#
# `KillMode=process` останавливает только главный процесс юнита; порождённые
# задачи доживают до конца и снимают замок сами.
KillMode=process
