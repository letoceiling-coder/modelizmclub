# Frontend build-time configuration.
#
# Every VITE_* value is baked into the client bundle at build time and is
# therefore PUBLIC — visible to anyone who opens the site. Never put a secret
# here; server-side secrets belong in backend/.env.
#
# In production these are exported by deploy/scripts/deploy-frontend.sh rather
# than read from a file, so this sample exists for local development and as the
# canonical list of what the build understands.

# Laravel API base, including the version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Reverb / Echo websockets. APP_KEY here is the *public* channel key
# (REVERB_APP_KEY in backend/.env) — the secret is REVERB_APP_SECRET and it
# must never appear in this file.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# `true` serves the UI from local mock data with no backend calls.
VITE_DEMO_MODE=false

# Shown in the document title / header.
VITE_APP_NAME=МоДелизМ

# Яндекс.Метрика: номер счётчика. Пусто — счётчик не подключается вовсе,
# и это штатный режим разработки: Вебвизор не должен писать локальные
# сессии. На проде номер приезжает переменной окружения из deploy-frontend.sh
# (METRIKA_ID в backend/.env), потому что сборка идёт в отдельном дереве и
# этот файл в неё не попадает.
VITE_METRIKA_ID=

# Карты Яндекса: ключ JavaScript API. Пусто — карта пунктов выдачи не
# показывается вовсе, и выбрать ПВЗ можно списком с поиском по адресу.
# Как и номер счётчика, приезжает переменной окружения из deploy-frontend.sh
# (YANDEX_MAPS_KEY в backend/.env).
VITE_YANDEX_MAPS_KEY=
