<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Strict PostgreSQL test database (see .env.testing + setup-test-db.sh) -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="modelizmclub_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Default false; individual tests opt in via config(['feed.auto_publish' => true]) -->
        <env name="FEED_AUTO_PUBLISH" value="false"/>
        <!-- Empty so tests that call notify() never hit the live MAX API. -->
        <env name="MAX_BOT_TOKEN" value=""/>
        <env name="MAX_BOT_USERNAME" value=""/>
        <!-- Wallet escrow by default; VTB hold tests opt in and fake the gateway. -->
        <env name="SAFE_DEAL_ESCROW_PROVIDER" value="wallet"/>
        <!--
          Тесты не отправляют настоящих SMS. 13.09 прогон на боевом сервере
          ушёл в iqsms с рабочими доступами из .env.testing — phpunit.xml драйвер
          SMS не задавал. Пустые доступы — ровно то, что видит CI: клиент
          бросает «credentials are not configured» до сети. force="true" —
          чтобы не перебили ни .env.testing, ни переменные оболочки. Юнит-тесты
          клиентов задают конфиг сами и работают через Http::fake.
        -->
        <env name="SMS_DRIVER" value="iqsms" force="true"/>
        <env name="IQSMS_LOGIN" value="" force="true"/>
        <env name="IQSMS_PASSWORD" value="" force="true"/>
        <env name="IQSMS_ACCESS_POINT" value="http://127.0.0.1:9" force="true"/>
        <env name="MTS_LOGIN" value="" force="true"/>
        <env name="MTS_PASSWORD" value="" force="true"/>
        <env name="MTS_TOKEN" value="" force="true"/>
        <env name="MTS_OMNICHANNEL_URL" value="http://127.0.0.1:9" force="true"/>
        <env name="MTS_TOKEN_API_URL" value="http://127.0.0.1:9" force="true"/>
    </php>
</phpunit>
